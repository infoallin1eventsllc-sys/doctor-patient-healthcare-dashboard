rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Default-Deny Catchall
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Valid ID Format Verification
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Clinical patient states collection match
    match /patient_states/{stateId} {
      allow read, write: if isValidId(stateId);
    }
  }
}
